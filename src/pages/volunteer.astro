---
const siteTitle = "Become a Partner";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{siteTitle} | Kingdom Expansion Mission</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    :root {
      --white: #ffffff;
      --black: #0a0a0a;
      --dark-blue: #0b1d3a;
      --accent: #4a9eff;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--black);
      color: var(--white);
      line-height: 1.6;
    }
    header {
      background: var(--dark-blue);
      padding: 1.5rem 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .logo { font-size: 1.4rem; font-weight: 800; color: var(--white); text-decoration: none; }
    .logo span { color: var(--accent); }
    nav a { color: var(--white); text-decoration: none; margin-left: 2rem; font-size: 0.95rem; opacity: 0.85; }
    nav a:hover { color: var(--accent); opacity: 1; }

    .form-container { max-width: 720px; margin: 3rem auto; padding: 2rem; }
    h1 { font-size: clamp(1.75rem, 4vw, 2.5rem); margin-bottom: 0.5rem; font-weight: 800; letter-spacing: -0.5px; }
    .subtitle { color: var(--accent); margin-bottom: 0.75rem; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; font-size: 0.85rem; }
    .description { opacity: 0.75; margin-bottom: 2.5rem; font-size: 0.98rem; }

    .form-group { margin-bottom: 1.5rem; }
    label { display: block; margin-bottom: 0.5rem; font-weight: 500; font-size: 0.92rem; }
    .required { color: var(--accent); }
    input, select, textarea {
      width: 100%;
      padding: 0.85rem 1rem;
      border-radius: 10px;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.04);
      color: var(--white);
      font-size: 1rem;
      font-family: inherit;
      transition: border-color 0.2s, background 0.2s;
    }
    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: var(--accent);
      background: rgba(74, 158, 255, 0.06);
    }
    textarea { min-height: 120px; resize: vertical; }
    select option { background: var(--dark-blue); color: var(--white); }

    .radio-group { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 0.5rem; }
    .radio-group label {
      display: flex; align-items: center; gap: 0.6rem;
      font-weight: 400; cursor: pointer;
      padding: 0.75rem 1rem; border-radius: 8px;
      border: 1px solid rgba(255,255,255,0.08);
      transition: background 0.2s, border-color 0.2s;
    }
    .radio-group label:hover { border-color: rgba(74,158,255,0.4); background: rgba(74,158,255,0.04); }
    .radio-group input { width: auto; accent-color: var(--accent); }
    .radio-group label:has(input:checked) { border-color: var(--accent); background: rgba(74,158,255,0.08); }

    button[type="submit"] {
      width: 100%; padding: 1.1rem;
      border-radius: 10px; border: none;
      background: var(--accent); color: var(--black);
      font-size: 1.05rem; font-weight: 700; cursor: pointer;
      margin-top: 1rem; transition: transform 0.2s, box-shadow 0.2s;
    }
    button[type="submit"]:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 12px 32px rgba(74,158,255,0.3);
    }
    button[type="submit"]:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

    #success-message { display: none; text-align: center; padding: 4rem 2rem; }
    #success-message h2 { font-size: 2rem; margin-bottom: 1rem; color: var(--accent); }
    #success-message p { opacity: 0.85; margin-bottom: 0.5rem; }
    .home-btn {
      display: inline-block; margin-top: 2rem;
      padding: 0.9rem 2rem; background: var(--accent);
      color: var(--black); text-decoration: none;
      border-radius: 10px; font-weight: 700;
    }
    .home-btn:hover { opacity: 0.9; }

    @media (max-width: 700px) {
      header { padding: 1rem; flex-wrap: wrap; gap: 0.75rem; }
      nav a { margin-left: 1rem; font-size: 0.85rem; }
      .form-container { padding: 1.25rem; margin: 1.5rem auto; }
    }
  </style>
</head>
<body>
  <header>
    <a href="/" class="logo">Kingdom<span>Mission</span></a>
    <nav>
      <a href="/about">About</a>
      <a href="/mission">Mission</a>
      <a href="/volunteer">Volunteer</a>
      <a href="/blog">Blog</a>
      <a href="/give">Give</a>
    </nav>
  </header>

  <div class="form-container">
    <div id="form-wrapper">
      <p class="subtitle">Kingdom Expansion Partnership</p>
      <h1>Once a year, my investment in God's Kingdom</h1>
      <p class="description">
        Fill in your details below to become a partner in the mission. Our team will reach out to
        you personally. Every field marked <span class="required">*</span> is required.
      </p>

      <form id="partnership-form">
        <div class="form-group">
          <label for="fullName">Full Name <span class="required">*</span></label>
          <input type="text" id="fullName" name="fullName" required />
        </div>

        <div class="form-group">
          <label for="email">Email Address <span class="required">*</span></label>
          <input type="email" id="email" name="email" required />
        </div>

        <div class="form-group">
          <label for="phone">Phone / WhatsApp <span class="required">*</span></label>
          <input type="tel" id="phone" name="phone" placeholder="+977 98XXXXXXXX" required />
        </div>

        <div class="form-group">
          <label for="address">Address (City, Country)</label>
          <input type="text" id="address" name="address" placeholder="Kathmandu, Nepal" />
        </div>

        <div class="form-group">
          <label for="churchRole">Your Role in Church <span class="required">*</span></label>
          <select id="churchRole" name="churchRole" required>
            <option value="">Select your role</option>
            <option value="Pastor">Pastor</option>
            <option value="Elder">Elder</option>
            <option value="Deacon">Deacon</option>
            <option value="Youth Leader">Youth Leader</option>
            <option value="Worship Leader">Worship Leader</option>
            <option value="Member">Member</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <div class="form-group">
          <label for="organization">Organization / Church Connected With</label>
          <input type="text" id="organization" name="organization" placeholder="e.g., Grace Church, Kathmandu" />
        </div>

        <div class="form-group">
          <label>Partnership Type <span class="required">*</span></label>
          <div class="radio-group">
            <label><input type="radio" name="partnershipType" value="Prayer Partner" required /> Prayer Partner</label>
            <label><input type="radio" name="partnershipType" value="Financial Partner" /> Financial Partner</label>
            <label><input type="radio" name="partnershipType" value="Volunteer Partner" /> Volunteer Partner</label>
            <label><input type="radio" name="partnershipType" value="Full-Time Missionary" /> Full-Time Missionary</label>
          </div>
        </div>

        <div class="form-group">
          <label for="investmentAmount">Investment Amount (NPR)</label>
          <input type="number" id="investmentAmount" name="investmentAmount" placeholder="e.g., 5000" min="0" />
        </div>

        <div class="form-group">
          <label>Frequency <span class="required">*</span></label>
          <div class="radio-group">
            <label><input type="radio" name="frequency" value="One-time" required /> One-time</label>
            <label><input type="radio" name="frequency" value="Monthly" /> Monthly</label>
            <label><input type="radio" name="frequency" value="Yearly" /> Yearly — "Once a year, my investment in God's Kingdom"</label>
          </div>
        </div>

        <div class="form-group">
          <label for="message">Message / Prayer Request</label>
          <textarea id="message" name="message" placeholder="Share your heart, prayer requests, or how you'd like to get involved..."></textarea>
        </div>

        <input type="hidden" id="signedIn" name="signedIn" value="No" />

        <button type="submit" id="submit-btn">Submit Partnership Form</button>
      </form>
    </div>

    <div id="success-message">
      <h2>🙏 Thank You!</h2>
      <p>Your partnership form has been received.</p>
      <p>We are grateful for your heart for God's Kingdom.</p>
      <p style="opacity: 0.6; margin-top: 1rem; font-size: 0.9rem;">Our team will reach out to you soon.</p>
      <a href="/" class="home-btn">Return Home</a>
    </div>
  </div>

  <script>
    // ⚠️ REPLACE THIS with the Web App URL you copied from Apps Script
    const APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbzk1-dNORo4pEP5IJ5exnhU6d8zntrtKqnLM_c4Zd2ALXw2vfUavD3Hu9NHzaM5wVs/exec";

    const form = document.getElementById("partnership-form");
    const submitBtn = document.getElementById("submit-btn");
    const formWrapper = document.getElementById("form-wrapper");
    const successMessage = document.getElementById("success-message");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = "Submitting...";

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        await fetch(APPS_SCRIPT_URL, {
          method: "POST",
          mode: "no-cors",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });

        formWrapper.style.display = "none";
        successMessage.style.display = "block";
        window.scrollTo({ top: 0, behavior: "smooth" });

      } catch (error) {
        alert("Something went wrong. Please try again or contact us on WhatsApp.");
        submitBtn.disabled = false;
        submitBtn.textContent = "Submit Partnership Form";
      }
    });
  </script>
</body>
</html>